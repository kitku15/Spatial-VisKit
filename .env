# ==========================================
# MASTER CONFIGURATION
# ==========================================

# 1. Which dataset folder should the app load right now? 
# (This folder must exist inside your frontend 'public' directory)
ACTIVE_DATASET_FOLDER=data_static
# ACTIVE_DATASET_FOLDER=data_kitam

# 2. What mode is the app in? ("full" for your HPC pipeline, "lite" for BYOD)
VITE_APP_MODE=full

# 3. What is the title shown in the top left of the web app?
VITE_PROJECT_TITLE="CosMx SMI: Tyler - FFPE Human Colonic Biopsies"
# VITE_PROJECT_TITLE="CosMx SMI: Mouse Brain"

# 4. Where is the FastAPI backend running?
VITE_API_BASE_URL=/data_static